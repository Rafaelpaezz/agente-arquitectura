# Copie este archivo como .env y llene los valores. El .env NUNCA se sube al repositorio.

# --- Telegram (token que entrega @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Modelo de decisión: clasifica preguntas y extrae parámetros de la herramienta ---
# Por defecto Google Gemini (nivel gratuito) con su endpoint compatible con OpenAI.
# Llave en https://aistudio.google.com/apikey
DECISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DECISION_API_KEY=
DECISION_MODEL=gemini-3.8-flash
# Gemini 3 "piensa" antes de responder; "low" reduce ese razonamiento (más rápido). Déjelo vacío con Groq/Azure.
DECISION_REASONING_EFFORT=low
# Modelos de respaldo (separados por coma) si el principal responde 503/429/404
DECISION_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Alternativas:
#  Groq:         DECISION_BASE_URL=https://api.groq.com/openai/v1      DECISION_MODEL=llama-3.1-8b-instant
#  Azure OpenAI: DECISION_BASE_URL=https://<recurso>.openai.azure.com/openai/v1/   DECISION_MODEL=<nombre-del-deployment>

# --- Modelo que redacta la respuesta final ---
# Ruta 1 (modelo ajustado con QLoRA, servido por Ollama dentro de docker compose):
ANSWER_BASE_URL=http://ollama:11434/v1
ANSWER_API_KEY=ollama
ANSWER_MODEL=arqui-qwen2.5-3b-ft
# Para comparar contra el modelo base sin ajuste: ANSWER_MODEL=qwen2.5:3b-instruct
# Ruta 2 (few-shot dinámico con un modelo por API): use los mismos valores de DECISION_*
ANSWER_REASONING_EFFORT=
# Respaldo del redactor (Ruta 2 con Gemini): ANSWER_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
ANSWER_FALLBACK_MODELS=
ANSWER_TEMPERATURE=0.2
ANSWER_MAX_TOKENS=1200

# --- Few-shot dinámico ---
FEWSHOT_ENABLED=on
# clasificacion (criterio por defecto) | similitud (criterio alternativo para comparar)
FEWSHOT_SELECTOR=clasificacion
FEWSHOT_K=3

# --- RAG ---
# fastembed (local, gratis, multilingüe) | tfidf (sin descargas, solo para pruebas)
EMBEDDINGS_BACKEND=fastembed
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.30

# --- Rutas: en Docker las fija docker-compose.yml; en local se usan ./indice, ./trazas y ./modelos ---
# INDEX_DIR=indice
# TRACES_DIR=trazas
# MODELS_CACHE_DIR=modelos
